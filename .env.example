# Environment Configuration Template
# Copy to .env.prod and fill in with your actual values
# DO NOT commit .env.prod or other .env files to version control

# AWS Configuration
AWS_PROFILE=your-aws-profile
EXPECTED_ACCOUNT=your-aws-account-id
AWS_REGION=ap-southeast-2

# Billing & Cost Alerts
BILLING_ALERT_EMAIL=your-alert-email@example.com
BILLING_DAILY_LIMIT=1
BILLING_SOURCE_ACCOUNT_ID=your-aws-account-id

# Application Configuration (obtain from secure secrets store)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=

# LLM API Keys (obtain from secure secrets store)
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MINIMAX_API_KEY=your-minimax-api-key
ACTIVE_PROVIDER=openai
ACTIVE_MODEL=gpt-5-mini

# GitHub Integration (obtain from secure secrets store)
GITHUB_TOKEN=your-github-token

# Security Configuration
DASHBOARD_PASSWORD=your-dashboard-password

# Cloudflare Configuration (obtain from secure secrets store)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# Production Domains
CLAW_DOMAIN_DASHBOARD=your-dashboard-domain.com
CLAW_DOMAIN_API=your-api-domain.com
